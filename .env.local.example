# Supabase (Settings > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI API 키 — 키를 넣은 AI만 모니터링에 자동으로 포함됩니다.
# (OPENAI_API_KEY는 답변 분석에도 쓰이므로 필수)
OPENAI_API_KEY=
GEMINI_API_KEY=
# Perplexity: perplexity.ai > Settings > API 에서 발급
PERPLEXITY_API_KEY=
# Claude: platform.claude.com > API Keys 에서 발급
ANTHROPIC_API_KEY=

# 모니터링에 쓸 모델 (미지정 시 gpt-5.4-mini / gemini-3.8-flash / perplexity/sonar / claude-opus-5-5)
# 모델을 바꾸면 src/lib/pricing.ts의 단가표도 함께 업데이트하세요.
OPENAI_MODEL=
GEMINI_MODEL=
PERPLEXITY_MODEL=
# 비용을 줄이려면 claude-sonnet-5-5 (Opus의 약 절반)
CLAUDE_MODEL=

# 키는 있지만 특정 AI만 돌리고 싶을 때 쉼표로 지정 (비워두면 키가 있는 AI 전부)
# 예: MONITOR_PROVIDERS=chatgpt,gemini,perplexity
MONITOR_PROVIDERS=

# 질문을 보내는 방식 (기본 natural)
#  natural: 사람이 검색창에 치는 문장을 그대로 보냄 (실제 화면과 가장 비슷)
#  list:    "추천 병원을 1~10위로 나열하라"고 형식을 지시하는 예전 방식
MONITOR_QUERY_MODE=natural

# 같은 질문을 같은 AI에 몇 번 물을지 (1~5, 기본 3).
# AI 답변은 물을 때마다 달라지므로 여러 번 물어 '노출 확률'로 봅니다. 비용은 이 배수만큼 늘어납니다.
MONITOR_SAMPLES=3

# 결과가 갈린 질문(예: 3회 중 1~2회 노출)만 이 횟수까지 더 묻습니다 (기본 5, 최대 8)
MONITOR_MAX_SAMPLES=5

# 질문 표현 생성에 쓸 모델 (미지정 시 ANALYSIS_MODEL 또는 gpt-4o-mini)
VARIANT_MODEL=

# 경쟁 병원 실존 확인: 공공데이터포털(data.go.kr) '건강보험심사평가원_병원정보서비스' 활용 신청 후 받은 인증키
# 비워두면 확인 기능이 꺼집니다.
HIRA_SERVICE_KEY=

# AI별 동시 호출 수 (기본 6). 429(호출 한도) 오류가 나면 낮추세요.
MONITOR_CONCURRENCY=

# 정기 자동 실행(Vercel Cron) 보안 키 - 임의의 랜덤 문자열
CRON_SECRET=

# 자동 모니터링 주기(일). 비워두면 2일에 한 번 실행됩니다.
# cron은 매일 깨우고, 마지막 실행 후 이 일수가 지난 클라이언트만 다시 돌립니다.
# 화면의 '모니터링 실행' 버튼은 이 설정과 무관하게 언제든 쓸 수 있습니다.
MONITOR_INTERVAL_DAYS=2

# 로그인 세션 서명 키 - 임의의 랜덤 문자열
AUTH_SECRET=

# 리포트 이메일 발송 (Gmail 계정으로 발송)
# 발송 전용으로 쓸 Gmail 주소
GMAIL_USER=
# 위 계정에서 2단계 인증 켠 후 발급한 앱 비밀번호 (myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD=

# 네이버 검색광고 API (월간 검색량·연관 키워드) — 검색광고 관리시스템 > 도구 > API 사용 관리
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# 네이버 검색 API (플레이스·블로그·웹문서 노출) — 네이버클라우드 콘솔 > NAVER API HUB > Application 등록 후 '인증 정보'
# 검색 서비스에서 블로그·지역·웹문서를 모두 체크하세요. 하루 25,000회 무료.
# (2026-07-31 이전 네이버 개발자센터에서 받은 키도 그대로 넣으면 자동으로 예전 주소로 씁니다)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
