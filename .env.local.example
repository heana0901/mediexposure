# Supabase (Settings > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI API 키
OPENAI_API_KEY=
GEMINI_API_KEY=

# 모니터링에 쓸 모델 (미지정 시 gpt-4o / gemini-2.5-flash)
# 모델을 바꾸면 src/lib/pricing.ts의 단가표도 함께 업데이트하세요.
OPENAI_MODEL=
GEMINI_MODEL=

# 정기 자동 실행(Vercel Cron) 보안 키 - 임의의 랜덤 문자열
CRON_SECRET=

# 자동 모니터링 주기(일). 비워두면 2일에 한 번 실행됩니다.
# cron은 매일 깨우고, 마지막 실행 후 이 일수가 지난 클라이언트만 다시 돌립니다.
# 화면의 '모니터링 실행' 버튼은 이 설정과 무관하게 언제든 쓸 수 있습니다.
MONITOR_INTERVAL_DAYS=2

# 로그인 세션 서명 키 - 임의의 랜덤 문자열
AUTH_SECRET=

# 리포트 이메일 발송 (Gmail 계정으로 발송)
# 발송 전용으로 쓸 Gmail 주소
GMAIL_USER=
# 위 계정에서 2단계 인증 켠 후 발급한 앱 비밀번호 (myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD=
