# Supabase (Settings > API 에서 확인)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI API 키
OPENAI_API_KEY=
GEMINI_API_KEY=

# 정기 자동 실행(Vercel Cron) 보안 키 - 임의의 랜덤 문자열
CRON_SECRET=

# 로그인 세션 서명 키 - 임의의 랜덤 문자열
AUTH_SECRET=

# 리포트 이메일 발송 (resend.com 에서 API 키 발급)
RESEND_API_KEY=
# 도메인 인증 전에는 비워두면 onboarding@resend.dev 로 발송됩니다 (본인 Resend 계정 이메일로만 수신 가능)
RESEND_FROM_EMAIL=
